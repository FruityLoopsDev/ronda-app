# Configuración de Entorno de RONDA

# Credenciales de Pinata para IPFS (Fase de Producción)
PINATA_API_KEY=tu_api_key_aqui
PINATA_SECRET=tu_secret_key_aqui

# Llave Privada de la Wallet Administradora de RONDA para acuñar los NFTs
RONDA_PRIVATE_KEY=0x_tu_private_key_aqui

# Configuración de Firebase Local Emulator (Opcional si se quiere correr en local)
FIRESTORE_EMULATOR_PORT=8080
AUTH_EMULATOR_PORT=9099
