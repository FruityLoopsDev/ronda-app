rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }
    
    function isSales() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'sales';
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || isSuperAdmin();
    }

    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }

    match /venues/{venueId} {
      allow read: if isSuperAdmin() || isSales();
      allow write: if isSuperAdmin();
    }

    match /leads/{leadId} {
      allow read: if isSuperAdmin() || (isSales() && resource.data.sales_uid == request.auth.uid);
      allow write: if isSuperAdmin() || (isSales() && resource.data.sales_uid == request.auth.uid);
    }
  }
}
