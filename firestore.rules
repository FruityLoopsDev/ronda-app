rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // SuperAdmin de Emergencia: Exclusivo UID maestro o cesar@ronda.uno verificado
    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'hVX2RL2xJhRFurJJsAgdyVIaDT53' ||
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email == 'cesar@ronda.uno'
        )
      );
    }

    function userRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('role', '')
        : '';
    }

    function getUserData(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data
        : {};
    }

    function isSuperAdmin() { 
      return request.auth != null && (
        isMasterAdmin() ||
        userRole(request.auth.uid) == 'superadmin'
      ); 
    }
    function isSales()      { return request.auth != null && userRole(request.auth.uid) == 'sales'; }
    function isNetwork()    { return request.auth != null && userRole(request.auth.uid) == 'network'; }
    function isAdmin()      { return request.auth != null && userRole(request.auth.uid) == 'admin'; }
    function isStaff()      { return isSuperAdmin() || isSales() || isNetwork() || isAdmin(); }

    function isVenueStaff(venueId) {
      return isSuperAdmin() || (
        isAdmin() && (
          getUserData(request.auth.uid).get('venueId', '') == venueId ||
          getUserData(request.auth.uid).get('venueIds', []).hasAny([venueId])
        )
      );
    }

    // Campos que el propio usuario NO puede alterar (NFTs, wallet, matches,
    // trustTier, verifications). Solo staff/servidor los modifican.
    function clientTouchedSensitive() {
      return resource != null && request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'trustTier', 'verifications', 'nfts', 'wallet_address', 'matches'
      ]);
    }

    function validClientVerificationAndPayment() {
      let changed = resource != null ? request.resource.data.diff(resource.data).affectedKeys() : request.resource.data.keys();
      // El cliente no puede auto-otorgarse isVerified, trustTier ni verifications completas.
      let noSensitiveVerification = !changed.hasAny(['isVerified', 'trustTier', 'verifications']);
      // Pago manual: solo puede marcar pendiente con Nequi, nunca otorgarse ticket.
      let okPayPending = !changed.hasAny(['paymentPending']) || request.resource.data.get('paymentPending', false) == true;
      let okPayMethod = !changed.hasAny(['paymentMethod']) || request.resource.data.get('paymentMethod', '') == 'nequi';
      return noSensitiveVerification && okPayPending && okPayMethod;
    }

    // --- Usuarios ---
    match /users/{userId} {
      // Privacidad: cada quien lee solo su propio documento; el staff lee todo.
      allow read: if request.auth != null && (request.auth.uid == userId || isStaff());

      // Alta: solo el propio usuario con rol 'client' (o cuenta staff maestra autorizada).
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && (
                      (request.resource.data.get('role', 'client') == 'client'
                        && request.resource.data.get('hasTicket', false) == false
                        && request.resource.data.get('trustTier', 0) == 0
                        && request.resource.data.get('isVerified', false) == false
                        && !request.resource.data.keys().hasAny([
                          'nfts', 'wallet_address', 'matches', 'verifications'
                        ]))
                      || isMasterAdmin()
                    );

      // Actualización: el propio usuario sin poder escalar su rol ni auto-otorgarse
      // ticket. El staff/admin puede actualizar para check-in, matches y emisión de certificados ($0 sin Cloud Functions).
      allow update: if request.auth != null && (
        isSuperAdmin()
        || (request.auth.uid == userId
          && request.resource.data.get('role', resource.data.get('role', 'client')) == resource.data.get('role', 'client')
          && request.resource.data.get('hasTicket', false) == resource.data.get('hasTicket', false)
          && !clientTouchedSensitive()
          && validClientVerificationAndPayment()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['kycStatus']) || request.resource.data.get('kycStatus', '') == 'pending'))
        || (isAdmin()
          && request.resource.data.get('role', resource.data.get('role', 'admin')) == resource.data.get('role', 'admin')
          && request.resource.data.get('venueId', resource.data.get('venueId', '')) == resource.data.get('venueId', '')
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'venueId', 'venueIds', 'venueCapabilities', 'trustTier', 'verifications', 'nfts', 'wallet_address', 'matches'
          ]))
      );

      allow delete: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());

      // Historial de encuentros (mem-rr): el usuario gestiona sus propios registros.
      match /encounters/{otherUid} {
        allow read: if request.auth != null && (request.auth.uid == userId || isStaff());
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Notificaciones
      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isStaff());
      }
      
      // Push Tokens
      match /pushTokens/{tokenId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isStaff());
      }
    }

    // --- Eventos / Salas ---
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if isSuperAdmin() || (
        isAdmin() && isVenueStaff(request.resource.data.get('venueId', ''))
      );
      allow update: if isSuperAdmin() || (
        isAdmin() && isVenueStaff(resource.data.get('venueId', request.resource.data.get('venueId', '')))
      );
      allow delete: if isSuperAdmin();

      // Likes: cada usuario escribe únicamente su propio like (${uid}_${targetUid}).
      // Privacidad P0: Solo el emisor puede leer su voto individual; el staff lee todos para calcular matches ($0).
      match /likes/{likeId} {
        allow read: if request.auth != null && (
          isStaff() || likeId.split('_')[0] == request.auth.uid
        );
        allow create, update, delete: if request.auth != null
          && likeId.split('_')[0] == request.auth.uid;
      }
    }

    // --- Chats Efímeros (72 horas) & Mensajería Segura ---
    match /chats/{chatId} {
      // Función pura en Firestore para prevenir filtración de números celulares colombianos o correos
      function containsContactLeak(text) {
        return text.matches('.*(\\+?57)?[\\s.-]*3[0-9]{2}[\\s.-]*[0-9]{3}[\\s.-]*[0-9]{4}.*')
          || text.matches('.*@[a-zA-Z0-9_.-]+\\.[a-zA-Z]{2,}.*');
      }

      // Expiración lógica por regla de tiempo ($0 sin cloud crons):
      // Lectura y escritura permitidas únicamente a los participantes antes de que expire el chat (72 horas)
      allow read: if request.auth != null && (
        isStaff() || (
          request.auth.uid in resource.data.participants &&
          request.time < resource.data.expiresAt
        )
      );
      allow create: if request.auth != null && (
        isStaff() || (
          request.auth.uid in request.resource.data.participants &&
          request.resource.data.expiresAt > request.time
        )
      );
      allow update: if request.auth != null && (
        isStaff() || (
          request.auth.uid in resource.data.participants &&
          request.time < resource.data.expiresAt &&
          (!request.resource.data.keys().hasAny(['lastMessage']) || !containsContactLeak(request.resource.data.lastMessage))
        )
      );
      allow delete: if isStaff();

      // Subcolección de mensajes individuales con blindaje anti-contacto en backend
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          isStaff() || (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
            request.time < get(/databases/$(database)/documents/chats/$(chatId)).data.expiresAt
          )
        );
        allow create: if request.auth != null && (
          isStaff() || (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
            request.time < get(/databases/$(database)/documents/chats/$(chatId)).data.expiresAt &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.text is string &&
            !containsContactLeak(request.resource.data.text)
          )
        );
        allow update, delete: if isStaff();
      }
    }

    // --- Locales (venues) ---
    match /venues/{venueId} {
      // Lectura: superadmin, staff operativo (red, ventas, anfitriones) o usuarios verificados (trustTier >= 1).
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        isStaff() ||
        isVenueStaff(venueId) ||
        getUserData(request.auth.uid).get('trustTier', 0) >= 1
      );
      // Actualización de ficha del local: superadmin y equipo de red; anfitrión de su propio local sin alterar términos fiscales/contractuales
      allow update: if isSuperAdmin() || isNetwork() || (
        isAdmin() && isVenueStaff(venueId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'nit', 'origin_scout_uid', 'affiliation_status', 'contract_id', 'territorial_terms', 'bar_package_price_cop'
        ])
      );
      allow create: if isSuperAdmin() || isNetwork();
      allow delete: if isSuperAdmin();
    }

    // --- Cierres de Noche / Liquidaciones Operativas de Barra ---
    match /night_closings/{closingId} {
      allow read: if request.auth != null && (
        isSuperAdmin() || isVenueStaff(resource.data.venueId)
      );
      allow create: if isSuperAdmin() || (
        isAdmin() && isVenueStaff(request.resource.data.venueId)
        && request.resource.data.status in ['draft', 'submitted']
      );
      allow update: if isSuperAdmin() || (
        isAdmin() && isVenueStaff(resource.data.venueId)
        && resource.data.status == 'draft'
        && request.resource.data.status in ['draft', 'submitted']
      );
      allow delete: if isSuperAdmin();
    }

    // --- Beneficios y Canjes en Barra ---
    match /benefit_redemptions/{redemptionId} {
      allow read: if request.auth != null && (
        isSuperAdmin() || isVenueStaff(resource.data.venueId) || request.auth.uid == resource.data.userId
      );
      allow create: if isSuperAdmin() || (
        isAdmin() && isVenueStaff(request.resource.data.venueId)
      );
      allow update, delete: if isSuperAdmin();
    }

    // --- Leads (CRM / ventas) ---
    match /leads/{leadId} {
      allow read: if isSuperAdmin() || isAdmin() || (
        isSales() && (
          resource.data.sales_uid == request.auth.uid ||
          resource.data.scout_uid == request.auth.uid ||
          resource.data.sales_uid == 'unassigned'
        )
      );
      allow create: if (
        (isSales() || isSuperAdmin() || isAdmin()) &&
        request.resource.data.sales_uid == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 150
      ) || (
        // Ingesta pública acotada desde partners.html (postulación de bares B2B)
        request.resource.data.keys().hasOnly(['id', 'name', 'zone', 'phone', 'status', 'source', 'notes', 'createdAt', 'sales_uid']) &&
        request.resource.data.status == 'lead' &&
        request.resource.data.sales_uid == 'unassigned' &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 150 &&
        request.resource.data.zone is string && request.resource.data.zone.size() <= 80 &&
        request.resource.data.phone is string && request.resource.data.phone.size() <= 40 &&
        request.resource.data.source in ['Desde Calculadora', 'Formulario Directo', 'Landing B2B'] &&
        request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
      );
      allow update: if isSuperAdmin() || isAdmin() || (
        isSales() && (
          resource.data.sales_uid == request.auth.uid ||
          resource.data.scout_uid == request.auth.uid ||
          (resource.data.sales_uid == 'unassigned' && request.resource.data.sales_uid == request.auth.uid)
        )
      );
      allow delete: if isSuperAdmin();

      match /history/{eventId} {
        allow read: if isSuperAdmin() || isSales() || isNetwork();
        allow create: if request.auth != null && (isSuperAdmin() || isSales() || isNetwork());
        allow update, delete: if isSuperAdmin();
      }


    // --- Solicitudes de Alta de Locales en Red (Scouts -> SuperAdmin/Network) ---
    match /venue_requests/{reqId} {
      allow read: if isSuperAdmin() || isNetwork() || isSales();
      allow create: if request.auth != null && (isSuperAdmin() || isNetwork() || isSales());
      allow update, delete: if isSuperAdmin() || isNetwork();
    }

    // --- Transacciones: solo servidor (Admin SDK). Clientes sin acceso. ---
    match /transactions/{txId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // --- Lista de espera: alta pública desde la landing; solo lectura staff. ---
    match /waitlist/{entryId} {
      // Alta pública: únicamente se permiten campos whitelist y con tipos correctos
      // (evita spam de campos arbitrarios). Sin rate-limit a nivel de reglas; mitigar
      // con funciones o detección de abuso si fuese necesario.
      allow create: if request.resource.data.keys().hasOnly([
            'name', 'linkedin', 'whatsapp', 'email', 'interestZone', 'source', 'createdAt'
          ])
          && request.resource.data.keys().size() <= 12
          && request.resource.data.name is string && request.resource.data.name.size() <= 120
          && request.resource.data.email is string && request.resource.data.email.size() <= 150
          && request.resource.data.whatsapp is string;
      allow read, update, delete: if isSuperAdmin();
    }

    // --- KYC Reviews ---
    match /kycReviews/{reviewId} {
      // El cliente crea su propia solicitud en estado 'pending'; no puede leerla ni modificarla después.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.status == 'pending';
      // Lectura y resolución: solo staff.
      allow read, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // --- B2B: Scouts (comerciales) y Hostes (bares aliados) ---
    match /scouts/{scoutId} {
      allow read: if isStaff();
      allow create, update: if isSuperAdmin() || isSales();
      allow delete: if isSuperAdmin();
    }
    match /hosts/{hostId} {
      allow read: if isStaff();
      allow create, update: if isSuperAdmin() || isSales() || isNetwork();
      allow delete: if isSuperAdmin();
    }

    // --- B2B: Ledger de comisiones, pagos y auditoría (solo servidor/superadmin) ---
    match /commission_ledger/{entryId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }
    match /payouts/{payoutId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // --- B2B: Ofertas de host, encuestas de churn y tokens de inversión ---
    match /host_offers/{offerId} {
      allow read: if isStaff();
      allow create, update: if isSuperAdmin() || isSales() || isNetwork();
      allow delete: if isSuperAdmin();
    }
    match /churn_surveys/{surveyId} {
      allow read: if isStaff();
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }
    match /invest_tokens/{tokenId} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }
    match /support_tickets/{ticketId} {
      allow read: if isSuperAdmin() || (isAdmin() && isVenueStaff(resource.data.venueId));
      allow create: if isSuperAdmin() || (isAdmin() && isVenueStaff(request.resource.data.venueId));
      allow update, delete: if isSuperAdmin();
    }

    // --- Métricas públicas de plataforma (contador de visitas anónimo) ---
    match /stats/{statId} {
      allow read: if true;
      allow create: if statId == 'visits' && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if statId == 'visits' && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1;
      allow delete: if isSuperAdmin();
    }

    // --- Chats 1:1: solo participantes del match, sin modificar participantes/id/evento ---
    match /chats/{chatId} {
      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'id', 'eventId', 'createdAt']);
      allow delete: if isSuperAdmin();
    }

  }
}
