rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function userRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isSuperAdmin() { return request.auth != null && userRole(request.auth.uid) == 'superadmin'; }
    function isSales()      { return request.auth != null && userRole(request.auth.uid) == 'sales'; }
    function isNetwork()    { return request.auth != null && userRole(request.auth.uid) == 'network'; }
    function isAdmin()      { return request.auth != null && userRole(request.auth.uid) == 'admin'; }
    function isStaff()      { return isSuperAdmin() || isSales() || isNetwork() || isAdmin(); }

    // Campos que el propio usuario NO puede alterar (NFTs, wallet, matches,
    // trustTier, verifications). Solo staff/servidor los modifican.
    function clientTouchedSensitive() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'trustTier', 'verifications', 'nfts', 'wallet_address', 'matches'
      ]);
    }

    // Validación de campos de verificación y pago cuando el cliente actualiza su propio perfil:
    // - isVerified / linkedinVerified: el cliente no puede revocarlos una vez verificados,
    //   pero puede activarlos tras el flujo de validación LinkedIn / KYC ($0 en cliente).
    // - paymentPending / paymentMethod: el cliente solo puede marcar pago pendiente ('nequi'),
    //   nunca otorgarse hasTicket (que se valida en allow update).
    function validClientVerificationAndPayment() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let okVerified = !changed.hasAny(['isVerified']) || request.resource.data.isVerified == true;
      let okLinkedin = !changed.hasAny(['linkedinVerified']) || request.resource.data.linkedinVerified == true;
      let okPayPending = !changed.hasAny(['paymentPending']) || request.resource.data.paymentPending == true;
      let okPayMethod = !changed.hasAny(['paymentMethod']) || request.resource.data.paymentMethod == 'nequi';
      return okVerified && okLinkedin && okPayPending && okPayMethod;
    }

    // --- Usuarios ---
    match /users/{userId} {
      // Privacidad: cada quien lee solo su propio documento; el staff lee todo.
      allow read: if request.auth != null && (request.auth.uid == userId || isStaff());

      // Alta: solo el propio usuario, y SIEMPRE con rol 'client' (sin auto-elevación).
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'client';

      // Actualización: el propio usuario sin poder escalar su rol ni auto-otorgarse
      // ticket. El staff/admin puede actualizar para check-in, matches y emisión de certificados ($0 sin Cloud Functions).
      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.get('role', resource.data.role) == resource.data.role
          && request.resource.data.get('hasTicket', false) == resource.data.get('hasTicket', false)
          && !clientTouchedSensitive()
          && validClientVerificationAndPayment())
        || isSuperAdmin()
        || isAdmin()
      );

      allow delete: if isSuperAdmin();

      // Historial de encuentros (mem-rr): el usuario gestiona sus propios registros.
      match /encounters/{otherUid} {
        allow read: if request.auth != null && (request.auth.uid == userId || isStaff());
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Notificaciones
      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isStaff());
      }
      
      // Push Tokens
      match /pushTokens/{tokenId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isStaff());
      }
    }

    // --- Eventos / Salas ---
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isStaff();

      // Likes: cada usuario escribe únicamente su propio like (${uid}_${targetUid}).
      // Privacidad P0: Solo el emisor puede leer su voto individual; el staff lee todos para calcular matches ($0).
      match /likes/{likeId} {
        allow read: if request.auth != null && (
          isStaff() || likeId.split('_')[0] == request.auth.uid
        );
        allow create, update, delete: if request.auth != null
          && likeId.split('_')[0] == request.auth.uid;
      }
    }

    // --- Chats Efímeros (72 horas) ---
    match /chats/{chatId} {
      // Expiración lógica por regla de tiempo ($0 sin cloud crons):
      // Lectura y escritura permitidas únicamente a los participantes antes de que expire el chat (72 horas)
      allow read: if request.auth != null && (
        isStaff() || (
          request.auth.uid in resource.data.participants &&
          request.time < resource.data.expiresAt
        )
      );
      allow create: if request.auth != null && (
        isStaff() || (
          request.auth.uid in request.resource.data.participants &&
          request.resource.data.expiresAt > request.time
        )
      );
      allow update: if request.auth != null && (
        isStaff() || (
          request.auth.uid in resource.data.participants &&
          request.time < resource.data.expiresAt
        )
      );
      allow delete: if isStaff();
    }

    // --- Locales (venues) ---
    match /venues/{venueId} {
      allow read: if request.auth != null && isStaff();
      allow write: if isSuperAdmin();
    }

    // --- Leads (CRM / ventas) ---
    match /leads/{leadId} {
      allow read, update: if isSuperAdmin() || (isSales() && resource.data.sales_uid == request.auth.uid);
      allow create: if isSuperAdmin() || isSales();
      allow delete: if isSuperAdmin();
    }

    // --- Transacciones: solo servidor (Admin SDK). Clientes sin acceso. ---
    match /transactions/{txId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // --- Lista de espera: alta pública desde la landing; solo lectura staff. ---
    match /waitlist/{entryId} {
      // Alta pública: únicamente se permiten campos whitelist y con tipos correctos
      // (evita spam de campos arbitrarios). Sin rate-limit a nivel de reglas; mitigar
      // con funciones o detección de abuso si fuese necesario.
      allow create: if request.resource.data.keys().hasOnly([
            'name', 'linkedin', 'whatsapp', 'email', 'interestZone', 'source', 'createdAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.email is string
          && request.resource.data.whatsapp is string;
      allow read, update, delete: if isSuperAdmin();
    }

    // --- KYC Reviews: solo staff (superadmin/admin) lee y escribe. ---
    match /kycReviews/{reviewId} {
      allow read, write: if isStaff();
      allow create: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // --- B2B: Scouts (comerciales) y Hostes (bares aliados) ---
    match /scouts/{scoutId} {
      allow read: if isStaff();
      allow create, update: if isSuperAdmin() || isSales();
      allow delete: if isSuperAdmin();
    }
    match /hosts/{hostId} {
      allow read: if isStaff();
      allow create, update: if isSuperAdmin() || isSales() || isNetwork();
      allow delete: if isSuperAdmin();
    }

    // --- B2B: Ledger de comisiones, pagos y auditoría (solo servidor/superadmin) ---
    match /commission_ledger/{entryId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }
    match /payouts/{payoutId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // --- B2B: Ofertas de host, encuestas de churn y tokens de inversión ---
    match /host_offers/{offerId} {
      allow read: if isStaff();
      allow create, update: if isSuperAdmin() || isSales() || isNetwork();
      allow delete: if isSuperAdmin();
    }
    match /churn_surveys/{surveyId} {
      allow read: if isStaff();
      allow create, update: if isSuperAdmin() || isSales() || isNetwork();
      allow delete: if isSuperAdmin();
    }
    match /invest_tokens/{tokenId} {
      allow read: if isStaff();
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }
  }
}
