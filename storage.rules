rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isSuperAdmin() {
      return request.auth != null && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Carpeta temporal de fotos biométricas y documentos para verificación KYC
    match /kyc-temp/{userId}/{allPaths=**} {
      // El propio usuario puede subir sus fotos durante el proceso de verificación
      // Tamaño máximo por imagen: 5 MB; tipo mime restringido a imágenes
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      
      // Lectura exclusiva para el Administrador Central (superadmin)
      allow read: if isSuperAdmin();
      
      // Solo el superadmin o procesos de backend pueden borrar
      allow delete: if isSuperAdmin();
    }

    // Regla por defecto: denegar cualquier otro acceso no explícito
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
