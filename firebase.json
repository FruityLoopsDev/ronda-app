{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/landing.html"
      },
      {
        "source": "/landing",
        "destination": "/landing.html"
      },
      {
        "source": "/landing/**",
        "destination": "/landing.html"
      },
      {
        "source": "/invest",
        "destination": "/invest.html"
      },
      {
        "source": "/invest/**",
        "destination": "/invest.html"
      },
      {
        "source": "/partners",
        "destination": "/partners.html"
      },
      {
        "source": "/partners/**",
        "destination": "/partners.html"
      },
      {
        "source": "/inversionistas",
        "destination": "/invest.html"
      },
      {
        "source": "/inversionistas/**",
        "destination": "/invest.html"
      },
      {
        "source": "/app",
        "destination": "/index.html"
      },
      {
        "source": "/app/**",
        "destination": "/index.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin.html"
      },
      {
        "source": "/client",
        "destination": "/index.html"
      },
      {
        "source": "/client/**",
        "destination": "/index.html"
      },
      {
        "source": "/net",
        "destination": "/network.html"
      },
      {
        "source": "/net/**",
        "destination": "/network.html"
      },
      {
        "source": "/network",
        "destination": "/network.html"
      },
      {
        "source": "/network/**",
        "destination": "/network.html"
      },
      {
        "source": "/superadmin",
        "destination": "/superadmin.html"
      },
      {
        "source": "/superadmin/**",
        "destination": "/superadmin.html"
      },
      {
        "source": "/sales",
        "destination": "/crm.html"
      },
      {
        "source": "/sales/**",
        "destination": "/crm.html"
      },
      {
        "source": "/crm",
        "destination": "/crm.html"
      },
      {
        "source": "/crm/**",
        "destination": "/crm.html"
      },
      {
        "source": "/ronda",
        "destination": "/index.html"
      },
      {
        "source": "/ronda/**",
        "destination": "/index.html"
      },
      {
        "source": "/lobby",
        "destination": "/index.html"
      },
      {
        "source": "/lobby/**",
        "destination": "/index.html"
      },
      {
        "source": "/registro",
        "destination": "/index.html"
      },
      {
        "source": "/registro/**",
        "destination": "/index.html"
      },
      {
        "source": "/login",
        "destination": "/index.html"
      },
      {
        "source": "/login/**",
        "destination": "/index.html"
      },
      {
        "source": "/index",
        "destination": "/index.html"
      },
      {
        "source": "/index/**",
        "destination": "/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8081
    },
    "hosting": {
      "port": 5001
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}