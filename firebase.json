{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(), geolocation=(), payment=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://www.googleapis.com; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com https://identify.apache.org https://polygon-rpc.com https://gateway.pinata.cloud https://*.wompi.co https://checkout.wompi.co https://*.google.com https://api.github.com; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
          }
        ]
      },
      {
        "source": "/invest*",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive, nosnippet"
          },
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, private"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/landing.html"
      },
      {
        "source": "/landing",
        "destination": "/landing.html"
      },
      {
        "source": "/landing/**",
        "destination": "/landing.html"
      },
      {
        "source": "/invest",
        "destination": "/invest.html"
      },
      {
        "source": "/invest/**",
        "destination": "/invest.html"
      },
      {
        "source": "/partners",
        "destination": "/partners.html"
      },
      {
        "source": "/partners/**",
        "destination": "/partners.html"
      },
      {
        "source": "/inversionistas",
        "destination": "/invest.html"
      },
      {
        "source": "/inversionistas/**",
        "destination": "/invest.html"
      },
      {
        "source": "/app",
        "destination": "/index.html"
      },
      {
        "source": "/app/**",
        "destination": "/index.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin.html"
      },
      {
        "source": "/client",
        "destination": "/index.html"
      },
      {
        "source": "/client/**",
        "destination": "/index.html"
      },
      {
        "source": "/net",
        "destination": "/network.html"
      },
      {
        "source": "/net/**",
        "destination": "/network.html"
      },
      {
        "source": "/network",
        "destination": "/network.html"
      },
      {
        "source": "/network/**",
        "destination": "/network.html"
      },
      {
        "source": "/superadmin",
        "destination": "/superadmin.html"
      },
      {
        "source": "/superadmin/**",
        "destination": "/superadmin.html"
      },
      {
        "source": "/sales",
        "destination": "/crm.html"
      },
      {
        "source": "/sales/**",
        "destination": "/crm.html"
      },
      {
        "source": "/crm",
        "destination": "/crm.html"
      },
      {
        "source": "/crm/**",
        "destination": "/crm.html"
      },
      {
        "source": "/ronda",
        "destination": "/index.html"
      },
      {
        "source": "/ronda/**",
        "destination": "/index.html"
      },
      {
        "source": "/lobby",
        "destination": "/index.html"
      },
      {
        "source": "/lobby/**",
        "destination": "/index.html"
      },
      {
        "source": "/registro",
        "destination": "/index.html"
      },
      {
        "source": "/registro/**",
        "destination": "/index.html"
      },
      {
        "source": "/login",
        "destination": "/index.html"
      },
      {
        "source": "/login/**",
        "destination": "/index.html"
      },
      {
        "source": "/index",
        "destination": "/index.html"
      },
      {
        "source": "/index/**",
        "destination": "/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8081
    },
    "hosting": {
      "port": 5001
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}