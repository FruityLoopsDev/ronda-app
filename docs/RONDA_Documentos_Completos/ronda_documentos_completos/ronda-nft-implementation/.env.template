# RONDA MVP - Environment Variables Template
# Renombra a .env.local y completa los valores

# ============ FIREBASE ============
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=ronda-mvp.firebaseapp.com
FIREBASE_PROJECT_ID=ronda-mvp
FIREBASE_STORAGE_BUCKET=ronda-mvp.appspot.com
FIREBASE_MESSAGING_SENDER_ID=...
FIREBASE_APP_ID=...
FIREBASE_DATABASE_URL=https://ronda-mvp.firebaseio.com

# ============ DEMO MODE ============
DEMO=false  # true = Usa datos en-memory, false = Usa Firestore

# ============ NFT / BLOCKCHAIN ============

# Polygon RPC Endpoints
POLYGON_MUMBAI_RPC=https://rpc-mumbai.maticvigil.com
POLYGON_MAINNET_RPC=https://polygon-rpc.com

# Wallet privada de RONDA (para mintar NFTs)
# ⚠️ NUNCA COMMITS ESTO A GIT - guardar en Google Cloud Secret Manager
RONDA_PRIVATE_KEY=0x...

# Wallet treasury que recibe royalties (puede ser diferente)
RONDA_TREASURY_WALLET=0x7A...

# ============ IPFS / PINATA ============

# API keys de Pinata para subir metadata
PINATA_API_KEY=...
PINATA_SECRET_KEY=...

# ============ BLOCKCHAIN VERIFICATION ============

# API key de Etherscan para verificar contratos en explorer
ETHERSCAN_API_KEY=...

# ============ DEVELOPMENT ============

NODE_ENV=development  # development | production
DEBUG=false
REPORT_GAS=false

# ============ ANALYTICS (OPCIONAL) ============

MIXPANEL_TOKEN=...
SENTRY_DSN=...
